<?xml version="1.0" encoding="utf-8"?>
<!-- Layout da tela principal: textos centralizados em uma coluna -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tituloTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Olá, Carlos Eduardo!"
        android:textColor="#1F4E79"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/mensagemTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Meu primeiro aplicativo Android\nDesenvolvimento Mobile – UNIP"
        android:textColor="#475467"
        android:textSize="18sp" />

</LinearLayout>
