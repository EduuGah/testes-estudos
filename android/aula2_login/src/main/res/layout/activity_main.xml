<?xml version="1.0" encoding="utf-8"?>
<!-- Tela de login: LinearLayout vertical organiza título, campos e botão -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF1F8"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Título do sistema -->
    <TextView
        android:id="@+id/tituloTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Portal Acadêmico"
        android:textColor="#1F4E79"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="Entre com seu e-mail e senha"
        android:textColor="#475467"
        android:textSize="16sp" />

    <!-- Campo E-mail -->
    <EditText
        android:id="@+id/emailEditText"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/fundo_campo"
        android:hint="E-mail"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="14dp" />

    <!-- Campo Senha: inputType textPassword esconde os caracteres -->
    <EditText
        android:id="@+id/senhaEditText"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/fundo_campo"
        android:hint="Senha"
        android:inputType="textPassword"
        android:paddingHorizontal="14dp" />

    <!-- Botão Entrar -->
    <Button
        android:id="@+id/entrarButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="28dp"
        android:backgroundTint="#1F4E79"
        android:text="Entrar"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
