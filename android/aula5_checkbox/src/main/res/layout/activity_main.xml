<?xml version="1.0" encoding="utf-8"?>
<!-- Questionário com CheckBox: ScrollView permite rolar se o conteúdo crescer -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quais tecnologias você conhece?"
            android:textColor="#1F4E79"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Marque todas as opções que se aplicam"
            android:textColor="#475467"
            android:textSize="15sp" />

        <CheckBox
            android:id="@+id/javaCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="#1F4E79"
            android:paddingVertical="6dp"
            android:text="Java"
            android:textSize="18sp" />

        <CheckBox
            android:id="@+id/kotlinCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="#1F4E79"
            android:paddingVertical="6dp"
            android:text="Kotlin"
            android:textSize="18sp" />

        <CheckBox
            android:id="@+id/flutterCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="#1F4E79"
            android:paddingVertical="6dp"
            android:text="Flutter"
            android:textSize="18sp" />

        <CheckBox
            android:id="@+id/pythonCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="#1F4E79"
            android:paddingVertical="6dp"
            android:text="Python"
            android:textSize="18sp" />

        <Button
            android:id="@+id/verificarButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#1F4E79"
            android:text="Verificar Resposta"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Resultado exibido abaixo do botão -->
        <TextView
            android:id="@+id/resultadoTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:text="Selecione as opções e toque em Verificar Resposta."
            android:textColor="#1D2939"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
