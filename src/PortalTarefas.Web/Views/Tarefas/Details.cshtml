@model TarefaResumoViewModel
@{ ViewData["Title"] = $"Tarefa #{Model.Id}"; }
<h1>Detalhes da tarefa</h1>
<partial name="_ResumoTarefa" model="Model" />
<form asp-action="AlterarSituacao" asp-route-id="@Model.Id" method="post" class="acoes">
    @foreach (var s in SituacaoTarefa.Todas.Where(s => s != Model.Situacao))
    {
        <button type="submit" name="situacao" value="@s">Marcar como @s</button>
    }
</form>
<p class="acoes">
    <a class="botao" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
    <a asp-action="Index">Voltar para a lista</a>
</p>
