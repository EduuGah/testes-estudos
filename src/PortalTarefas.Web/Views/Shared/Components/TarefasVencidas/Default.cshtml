@model List<TarefaResumoViewModel>
<section class="painel-vencidas">
    <h3>Tarefas vencidas</h3>
    @if (Model.Count == 0)
    {
        <p class="vazio">Nenhuma tarefa vencida.</p>
    }
    else
    {
        <ul>
            @foreach (var t in Model)
            {
                <li><a asp-controller="Tarefas" asp-action="Details" asp-route-id="@t.Id">@t.Titulo</a>
                    <small>venceu em @t.Prazo?.ToString("dd/MM")</small></li>
            }
        </ul>
    }
</section>
