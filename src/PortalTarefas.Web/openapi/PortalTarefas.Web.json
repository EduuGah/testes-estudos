{
  "openapi": "3.1.1",
  "info": {
    "title": "Portal de Tarefas API",
    "description": "API do domínio didático Portal de Tarefas (UNIP – Desenvolvimento Web com .NET).",
    "version": "v1"
  },
  "paths": {
    "/api/tarefas": {
      "get": {
